-- Minimal Scroom Catch UI for Matcha

local Players = game:GetService("Players")
local LocalPlayer = Players and Players.LocalPlayer
local RunService = game:GetService("RunService")

if not LocalPlayer then
    warn("[ScroomCatch] Join the game before running this script.")
    return
end

local state = _G.__SCROOM_MINIMAL_STATE or {}
state.version = (state.version or 0) + 1
_G.__SCROOM_MINIMAL_STATE = state

pcall(function()
    if state.heartbeat then
        state.heartbeat:Disconnect()
    end
end)

pcall(function()
    UI.RemoveTab("Scroom Catch Minimal")
end)

local playerGui

local function isMinigameActive(name)
    if not playerGui or not playerGui.Parent then
        playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    end
    return playerGui and playerGui:FindFirstChild(name) ~= nil
end

local MAIN_SCAN_LIMIT = 2
local MAIN_SCAN_DELAY = 0.2
local mainCache
local mainScanAttempts = 0
local mainNextScanAt = 0
local mainPatchApplied = false

local function clearMain()
    mainCache = nil
    mainScanAttempts = 0
    mainNextScanAt = 0
    mainPatchApplied = false
end

local function scanMain()
    local ok, result = pcall(function()
        return findgc("_progressMult", {
            _progressMult = "number",
            _drainMult = "number",
            _progress = "number",
            _locked = "boolean",
            _zone = "table",
            _marker = "table",
            _item = "table",
            _rope = "table"
        })
    end)

    if not ok then
        warn("[ScroomCatch] main scan failed:", result)
        return nil
    end
    return result
end

local function maintainInstantCatch()
    if not UI.GetValue("sc_minimal_instant_catch")
        or not isMinigameActive("MainMinigame")
        or mainPatchApplied then
        return
    end

    if not mainCache then
        if mainScanAttempts >= MAIN_SCAN_LIMIT or tick() < mainNextScanAt then
            return
        end

        mainScanAttempts = mainScanAttempts + 1
        mainNextScanAt = tick() + MAIN_SCAN_DELAY
        mainCache = scanMain()

        if not mainCache or #mainCache == 0 then
            mainCache = nil
            if mainScanAttempts >= MAIN_SCAN_LIMIT then
                print("[ScroomCatch] main controller cache empty after 2 scans")
            end
            return
        end
    end

    local drainOk, drainWrites = pcall(applygc, mainCache, "_drainMult", 0)
    local unlockOk, unlockWrites = pcall(applygc, mainCache, "_locked", false)
    local progressOk, progressWrites = pcall(applygc, mainCache, "_progress", 1)
    local wroteProgress = tonumber(progressWrites) or 0

    if drainOk and unlockOk and progressOk and wroteProgress > 0 then
        mainPatchApplied = true
        print(
            "[ScroomCatch] instant catch applied; writes",
            tostring(progressWrites),
            tostring(drainWrites),
            tostring(unlockWrites)
        )
        return
    end

    warn(
        "[ScroomCatch] main apply failed or wrote nothing:",
        tostring(progressWrites),
        tostring(drainWrites),
        tostring(unlockWrites)
    )
    mainCache = nil
    mainNextScanAt = tick() + MAIN_SCAN_DELAY
end

local TUNE_SCAN_LIMIT = 2
local TUNE_SCAN_DELAY = 0.12
local tuneCache
local tuneScanAttempts = 0
local tuneNextScanAt = 0
local tunePatchApplied = false

local function clearTune()
    tuneCache = nil
    tuneScanAttempts = 0
    tuneNextScanAt = 0
    tunePatchApplied = false
end

local function scanTune()
    local ok, result = pcall(function()
        return findgc("_targetTime", {
            _targetTime = "number",
            _elapsed = "number",
            _target = "number",
            _needleX = "number",
            _needleVel = "number",
            _purity = "number",
            _dwell = "number",
            _ui = "table"
        })
    end)

    if not ok then
        warn("[ScroomCatch] frequency scan failed:", result)
        return nil
    end
    return result
end

local function maintainInstantFrequency()
    if not UI.GetValue("sc_minimal_instant_frequency")
        or not isMinigameActive("TuningMinigame")
        or tunePatchApplied then
        return
    end

    if not tuneCache then
        if tuneScanAttempts >= TUNE_SCAN_LIMIT or tick() < tuneNextScanAt then
            return
        end

        tuneScanAttempts = tuneScanAttempts + 1
        tuneNextScanAt = tick() + TUNE_SCAN_DELAY
        tuneCache = scanTune()

        if not tuneCache or #tuneCache == 0 then
            tuneCache = nil
            if tuneScanAttempts >= TUNE_SCAN_LIMIT then
                print("[ScroomCatch] frequency cache empty after 2 scans")
            end
            return
        end
    end

    local ok, changed = pcall(applygc, tuneCache, "_elapsed", 999)
    local writes = tonumber(changed) or 0
    if ok and writes > 0 then
        tunePatchApplied = true
        print("[ScroomCatch] instant frequency applied; writes", tostring(writes))
    else
        tuneCache = nil
        tuneNextScanAt = tick() + TUNE_SCAN_DELAY
        if tuneScanAttempts >= TUNE_SCAN_LIMIT then
            print("[ScroomCatch] frequency apply had no writes after 2 scans")
        end
    end
end

UI.AddTab("Scroom Catch Minimal", function(tab)
    local settings = tab:Section("Minigames", "Left")

    settings:Toggle(
        "sc_minimal_instant_catch",
        "Instant Catch",
        false,
        clearMain
    )

    settings:Toggle(
        "sc_minimal_instant_frequency",
        "Instant Frequency Minigame",
        false,
        clearTune
    )
end)

local version = state.version
local wasMainActive = false
local wasTuneActive = false

state.heartbeat = RunService.Heartbeat:Connect(function()
    if not _G.__SCROOM_MINIMAL_STATE
        or _G.__SCROOM_MINIMAL_STATE.version ~= version then
        state.heartbeat:Disconnect()
        return
    end

    local mainActive = isMinigameActive("MainMinigame")
    if mainActive ~= wasMainActive then
        clearMain()
        wasMainActive = mainActive
    end

    local tuneActive = isMinigameActive("TuningMinigame")
    if tuneActive ~= wasTuneActive then
        clearTune()
        wasTuneActive = tuneActive
    end

    local ok, err = pcall(function()
        maintainInstantCatch()
        maintainInstantFrequency()
    end)
    if not ok then
        warn("[ScroomCatch] heartbeat error:", err)
    end
end)

print("[ScroomCatch] Minimal script loaded")
